// Сценарий заявки #1274: значение 0 не должно быть неотличимо от отсутствующего
// ключа. Обработка ничего не чинит — она печатает наблюдаемое поведение, чтобы
// «до» и «после» слияния PR #1614 сравнивались на одних и тех же строках.
//
// Ожидаемое поведение (по заявке): все три строки должны печатать «Ложь».

Процедура Выполнить()

  Ноль = 0;
  Сообщить("[#1274] 0 = Неопределено -> " + Строка(Ноль = Неопределено));

  С = Новый Соответствие();
  С.Вставить("Повторы", 0);
  Сообщить("[#1274] Соответствие[Повторы] = Неопределено (ключ есть, значение 0) -> "
    + Строка(С.Получить("Повторы") = Неопределено));

  ПустаяСтрока = "";
  Сообщить("[#1274] "" = Неопределено -> " + Строка(ПустаяСтрока = Неопределено));

  Сообщить("[#1274] отсутствующий ключ = Неопределено -> "
    + Строка(С.Получить("НетТакого") = Неопределено) + " (здесь ожидается Истина)");

КонецПроцедуры
