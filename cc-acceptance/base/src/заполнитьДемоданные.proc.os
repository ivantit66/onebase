// Обезличенные данные пакета приёмки КЦ. Ни одного настоящего телефона, ФИО или
// адреса: всё синтетическое, безопасно прикладывать к PR и issue.
//
// Идемпотентно: справочники ищутся по наименованию.

Процедура Выполнить()

  // ---- филиалы ----
  СоздатьФилиал("Филиал 1");
  СоздатьФилиал("Филиал 2");
  Ф1 = Справочники.Филиал.НайтиПоНаименованию("Филиал 1");
  Ф2 = Справочники.Филиал.НайтиПоНаименованию("Филиал 2");

  // ---- группы неисправностей ----
  СоздатьГруппуНеисправностей("Группа A");
  СоздатьГруппуНеисправностей("Группа B");
  ГA = Справочники.ГруппаНеисправностей.НайтиПоНаименованию("Группа A");
  ГB = Справочники.ГруппаНеисправностей.НайтиПоНаименованию("Группа B");

  // ---- направления: у каждого свой филиал и своя группа неисправностей ----
  СоздатьНаправление("Направление A", Ф1, ГA);
  СоздатьНаправление("Направление B", Ф2, ГB);
  НA = Справочники.Направление.НайтиПоНаименованию("Направление A");
  НB = Справочники.Направление.НайтиПоНаименованию("Направление B");

  // ---- неисправности: по две на направление, в том числе одноимённые ----
  // Одинаковые наименования у разных направлений — это и есть случай, ради
  // которого нужен отбор: в общем списке их не различить.
  СоздатьНеисправность("Не включается", НA, ГA, Ложь);
  СоздатьНеисправность("Прочее", НA, ГA, Истина);
  СоздатьНеисправность("Не включается", НB, ГB, Ложь);
  СоздатьНеисправность("Прочее", НB, ГB, Ложь);

  // ---- адресный классификатор: город-ГРУППА и две улицы внутри ----
  Если ЗначениеЗаполнено(Справочники.АдресныйКлассификатор.НайтиПоНаименованию("Город Н")) = Ложь Тогда
    Город = Справочники.АдресныйКлассификатор.Создать();
    Город.Наименование = "Город Н";
    Город.Муниципальный = Ложь;
    // Служебные колонки: у признака группы и родителя нет русских имён.
    Город.is_folder = Истина;
    Город.Записать();
  КонецЕсли;
  Город = Справочники.АдресныйКлассификатор.НайтиПоНаименованию("Город Н");

  СоздатьУлицу("улица Первая", Город);
  СоздатьУлицу("улица Вторая", Город);

  Сообщить("Демоданные пакета приёмки записаны");

КонецПроцедуры

Процедура СоздатьФилиал(Имя)
  Если ЗначениеЗаполнено(Справочники.Филиал.НайтиПоНаименованию(Имя)) Тогда
    Возврат;
  КонецЕсли;
  Зап = Справочники.Филиал.Создать();
  Зап.Наименование = Имя;
  Зап.Записать();
КонецПроцедуры

Процедура СоздатьГруппуНеисправностей(Имя)
  Если ЗначениеЗаполнено(Справочники.ГруппаНеисправностей.НайтиПоНаименованию(Имя)) Тогда
    Возврат;
  КонецЕсли;
  Зап = Справочники.ГруппаНеисправностей.Создать();
  Зап.Наименование = Имя;
  Зап.Записать();
КонецПроцедуры

Процедура СоздатьНаправление(Имя, Филиал, Группа)
  Если ЗначениеЗаполнено(Справочники.Направление.НайтиПоНаименованию(Имя)) Тогда
    Возврат;
  КонецЕсли;
  Зап = Справочники.Направление.Создать();
  Зап.Наименование = Имя;
  Зап.Филиал = Филиал;
  Зап.ГруппаНеисправностей = Группа;
  Зап.Записать();
КонецПроцедуры

Процедура СоздатьНеисправность(Имя, Направление, Группа, Муниципальный)
  Зап = Справочники.Неисправность.Создать();
  Зап.Наименование = Имя;
  Зап.Направление = Направление;
  Зап.Группа = Группа;
  Зап.Муниципальный = Муниципальный;
  Зап.Записать();
КонецПроцедуры

Процедура СоздатьУлицу(Имя, Город)
  Если ЗначениеЗаполнено(Справочники.АдресныйКлассификатор.НайтиПоНаименованию(Имя)) Тогда
    Возврат;
  КонецЕсли;
  Зап = Справочники.АдресныйКлассификатор.Создать();
  Зап.Наименование = Имя;
  Зап.Муниципальный = Ложь;
  Зап.parent_id = Город;
  Зап.Записать();
КонецПроцедуры
