// Диалог подбора с серверным поиском (#1495). Строки собирает сервер: набранное
// приходит в ПодборЗапрос, отбор идёт здесь, диалог закрывать не нужно.

Процедура ПодборНажатие()
    ПоказатьНеисправности("");
КонецПроцедуры

Процедура ПодборПоиск()
    ПоказатьНеисправности(ПодборЗапрос);
КонецПроцедуры

Процедура ПоказатьНеисправности(Текст)
    Колонки = Новый Массив;
    Колонки.Добавить(Новый Структура("Имя,Заголовок,Тип,Редактируемое", "Наименование", "Неисправность", "string", Ложь));

    Запрос = Новый Запрос;
    Запрос.Текст = "ВЫБРАТЬ ПЕРВЫЕ 100
    |   Н.Ссылка       КАК Ид,
    |   Н.Наименование КАК Наименование
    |ИЗ Справочник.Неисправность КАК Н";

    Данные = Новый Массив;
    Для Каждого Стр Из Запрос.Выполнить() Цикл
        Если ПустаяСтрока(Текст) ИЛИ СтрСодержит(НРег(Стр.Наименование), НРег(Текст)) Тогда
            Данные.Добавить(Новый Структура("Идентификатор,Наименование",
                Строка(Стр.Ид), Стр.Наименование));
        КонецЕсли;
    КонецЦикла;

    Конфиг = Новый Структура("Заголовок,ПолеПоиска", "Неисправности", "Наименование");
    Конфиг.Вставить("ПоискНаСервере", Истина);
    ПоказатьПодбор(Данные, Колонки, Конфиг);
КонецПроцедуры
