// Обезличенные данные: две владельческие области и подчинённые элементы в
// обеих, включая папку — она проверяет, что choice_filter по is_folder
// продолжает действовать вместе с отбором по владельцу.

Процедура Выполнить()

    СоздатьНаправление("Направление A");
    СоздатьНаправление("Направление B");
    НA = Справочники.Направление.НайтиПоНаименованию("Направление A");
    НB = Справочники.Направление.НайтиПоНаименованию("Направление B");

    СоздатьНеисправность("A: не включается", НA, Ложь, "секрет A1");
    СоздатьНеисправность("A: шумит",        НA, Ложь, "секрет A2");
    СоздатьНеисправность("A: папка",        НA, Истина, "секрет A3");
    СоздатьНеисправность("B: не включается", НB, Ложь, "секрет B1");
    СоздатьНеисправность("B: течёт",         НB, Ложь, "секрет B2");

    Сообщить("Данные приёмки записаны");

КонецПроцедуры

Процедура СоздатьНаправление(Имя)
    Если ЗначениеЗаполнено(Справочники.Направление.НайтиПоНаименованию(Имя)) Тогда
        Возврат;
    КонецЕсли;
    Зап = Справочники.Направление.Создать();
    Зап.Наименование = Имя;
    Зап.Записать();
КонецПроцедуры

Процедура СоздатьНеисправность(Имя, Владелец, ЭтоПапка, Секрет)
    Если ЗначениеЗаполнено(Справочники.Неисправность.НайтиПоНаименованию(Имя)) Тогда
        Возврат;
    КонецЕсли;
    Зап = Справочники.Неисправность.Создать();
    Зап.Наименование = Имя;
    Зап.Владелец = Владелец;
    Зап.Секрет = Секрет;
    Зап.is_folder = ЭтоПапка;
    Зап.Записать();
КонецПроцедуры
